<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow loading R library from system location outside app bundle -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow debugging and development -->
    <key>com.apple.security.get-task-allow</key>
    <true/>

    <!-- Allow R to set LD_LIBRARY_PATH for loading packages -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Allow R's JIT compiler -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow R to send Apple Events (for some GUI operations) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
